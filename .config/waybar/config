{
    "layer": "top",
    "position": "top",
    "height": 40,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "network", "custom/wireguard", "pulseaudio", "battery", "custom/power"],

    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": false,
        "sort-by-number": true
    },

    "memory": {
        "interval": 30,
        "format": "  {used:0.1f}G/{total:0.1f}G"
    },

    "clock": {
        "interval": 1,
        "format": "{:%Y-%m-%d    |    %I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "network": {
        "format": "  {signalStrength}%",
        "format-disconnected": "󰖪",
        "on-click": "kitty -e nmtui",
        "format-ethernet": "󰈁 Eth"
    },

    "cpu": {
        "format": "{icon0}{icon1}{icon2}{icon3}   {usage}%",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "interval": 2,
        "states": {
            "critical": 90
        }
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  Muted",
        "format-icons": {
            "default": ["", " "]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "kitty -e ncpamixer"
    },

    "battery": {
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "events": {
            "on-discharging-warning": "hyprctl notify 0 4000 'rgb(f9e2af)' 'Low Battery (30%)'",
            "on-discharging-critical": "hyprctl notify 0 2147483647 'rgb(f38ba8)' 'Very Low Battery (15%)'",
            "on-charging-100": "hyprctl notify 1 4000 'rgb(a6e3a1)' 'Battery Full!'"
        },
        "format": "{icon} {capacity}%",
        "format-icons": ["󰁻", "󰁽", "󰁿", "󰂁", "󰁹"],
        "max-length": 25
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout",
        "tooltip": false
    },

    "custom/wireguard": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/wg-status.sh",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/wg-toggle.sh"
    }
}
